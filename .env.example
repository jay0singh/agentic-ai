# Copy this file to .env and fill in your keys. Never commit .env.

# PostgreSQL (matches the pgvector-db Docker container)
DB_NAME=vectordb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_TABLE=documents

# Groq (chat + judge, free tier) — create at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (embeddings, free tier) — create at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Models (all free-tier cloud models)
CHAT_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# Tavily (web search, optional) — https://tavily.com
TAVILY_API_KEY=

# GitHub (optional — raises API rate limits)
GITHUB_TOKEN=

# Langfuse (observability — optional, tracing stays disabled if unset)
# Keys: https://cloud.langfuse.com → project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
